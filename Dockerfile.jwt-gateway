# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the JWT gateway binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o jwt-gateway ./cmd/jwt-gateway

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates curl
WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/jwt-gateway .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3500/v1.0/healthz || exit 1

EXPOSE 3500

CMD ["./jwt-gateway"]